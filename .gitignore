# Node / web tier
node_modules/
src/terranova/ui_web/node_modules/
# NOTE: src/terranova/ui_web/dist/ is intentionally NOT ignored — the
# built bundle is committed so (a) qgis-plugin-ci can package it into
# the released plugin (it archives git-tracked files only) and (b)
# cloning + linking the plugin works without a Node toolchain.  Rebuild
# and commit dist when the UI changes.
deploy/cloudflare-worker/node_modules/
deploy/cloudflare-worker/.wrangler/
*.tsbuildinfo

# Local IDE / Claude state — never push these
.claude/
CLAUDE.md

# QGIS
*.qgs~
*.qgz~

# Project state (do not commit user training data)
*.zarr/
samples/_local/
docs/site/
site/

# Telemetry installation id (per-machine)
installation_id

# Packaging artefacts
terranova-*.zip
